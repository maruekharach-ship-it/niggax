-- RenderStepped Main Loop
RunService.RenderStepped:Connect(function()
    -- อัปเดต FOV Circle
    FOVCircle.Visible = Config.AimbotEnabled
    FOVCircle.Radius = Config.FovSize
    
    if Config.FovPosition == "FollowMouse" then
        FOVCircle.Position = UserInputService:GetMouseLocation()
    else
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
    
    if Config.FovRainbow then
        FOVCircle.Color = Color3.fromHSV(tick() % 4 / 4, 1, 1)
    else
        FOVCircle.Color = Color3.fromRGB(255, 0, 0)
    end
    
    -- Aimbot Logic
    if Config.AimbotEnabled and (Config.AutoLock or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
        local closestTarget = nil
        local shortestDist = Config.FovSize
        local centerPos = (Config.FovPosition == "FollowMouse") and UserInputService:GetMouseLocation() or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, target in ipairs(workspace:GetChildren()) do
            local isPlayer = Players:GetPlayerFromCharacter(target)
            local isNpc = target:FindFirstChildOfClass("Humanoid") and not isPlayer
            
            local canLock = false
            if isPlayer and Config.LockPlayer then
                local plr = Players:GetPlayerFromCharacter(target)
                if plr ~= LocalPlayer then
                    -- เช็คระบบเลือกฝั่ง
                    if next(Config.SelectedTeams) ~= nil then
                        if plr.Team and Config.SelectedTeams[plr.Team.Name] then canLock = true end
                    else
                        if not Config.TeamCheck or plr.Team ~= LocalPlayer.Team then canLock = true end
                    end
                end
            elseif isNpc and Config.LockNpc then
                canLock = true
            end
            
            if canLock and target:FindFirstChild(Config.AimPart) then
                local part = target[Config.AimPart]
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                    if dist < shortestDist then
                        -- Wallcheck
                        local allowed = true
                        if Config.WallCheck then
                            local ray = Ray.new(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 500)
                            local hit = workspace:FindPartOnWithIgnoreList(ray, {LocalPlayer.Character, target})
                            if hit and hit:IsA("BasePart") then allowed = false end
                        end
                        if allowed then
                            shortestDist = dist
                            closestTarget = part
                        end
                    end
                end
            end
        end
        
        if closestTarget then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / math.max(1, Config.Smoothness))
        end
    end
    
    -- TPWalk Logic
    if Config.TpWalkEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * Config.TpWalkSpeed)
        end
    end
    
    -- Jump Power Logic
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.UseJumpPower = true
            if Config.JumpPowerEnabled then
                hum.JumpPower = Config.JumpPowerVal
            else
                hum.JumpPower = 50 -- ค่าเริ่มต้น Roblox
            end
        end
    end
    
    -- Noclip Logic
    if Config.NoclipEnabled and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Infinite Jump Event
UserInputService.JumpRequest:Connect(function()
    if Config.InfJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

