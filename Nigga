local Tabs = {}
local currentTab = nil

local function createTab(tabName)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 120, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tabBtn.TextSize = 15
    tabBtn.Parent = TabHeader
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = tabBtn
    
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.BorderSizePixel = 0
    scrollFrame.CanvasSize = UDim2.new(0, 0, 2, 0)
    scrollFrame.ScrollBarThickness = 6
    scrollFrame.Visible = false
    scrollFrame.Parent = TabContainer
    
    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 8)
    listLayout.Parent = scrollFrame
    
    tabBtn.MouseButton1Click:Connect(function()
        for _, tabData in pairs(Tabs) do
            tabData.Button.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            tabData.Button.TextColor3 = Color3.fromRGB(200, 200, 200)
            tabData.Frame.Visible = false
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        scrollFrame.Visible = true
    end)
    
    Tabs[tabName] = {Button = tabBtn, Frame = scrollFrame}
    if not currentTab then
        currentTab = tabName
        tabBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        scrollFrame.Visible = true
    end
    return scrollFrame
end

