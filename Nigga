local function createInput(parent, name, defaultVal, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 38)
    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    
    local corner = Instance.new("UICorner")
